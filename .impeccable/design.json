  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "唯一以實心承載強調色的控制項。用於一個畫面上「確認送出」的那個動作。",
      "html": "<button class=\"ds-btn-primary\">儲存設定</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border:none;border-radius:var(--radius-md,8px);background:var(--accent-primary,#c9a24b);color:var(--text-on-accent,#14161a);font-family:\"Noto Sans TC\",-apple-system,sans-serif;font-size:14px;font-weight:500;box-shadow:0 1px 2px rgba(0,0,0,.3);transition:background .15s ease}.ds-btn-primary:hover{background:var(--accent-hover,#e0be72)}.ds-btn-primary:active{background:var(--accent-pressed,#a8853c)}.ds-btn-primary:focus-visible{outline:2px solid var(--focus-ring,#c9a24b);outline-offset:2px}.ds-btn-primary:disabled{opacity:.5;pointer-events:none}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "主要按鈕旁的非確認動作。色調式，不用強調色。",
      "html": "<button class=\"ds-btn-secondary\">測試連線</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border:none;border-radius:var(--radius-md,8px);background:var(--bg-tertiary,#1b302b);color:var(--text-primary,#eae4d6);font-family:\"Noto Sans TC\",-apple-system,sans-serif;font-size:14px;font-weight:500;box-shadow:0 1px 2px rgba(0,0,0,.3);transition:background .15s ease}.ds-btn-secondary:hover{background:rgba(27,48,43,.8)}.ds-btn-secondary:focus-visible{outline:2px solid var(--focus-ring,#c9a24b);outline-offset:2px}.ds-btn-secondary:disabled{opacity:.5;pointer-events:none}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "未 hover 前沒有填色。密集列中純圖示動作的預設選擇。",
      "html": "<button class=\"ds-btn-ghost\">取消</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border:none;border-radius:var(--radius-md,8px);background:transparent;color:var(--text-primary,#eae4d6);font-family:\"Noto Sans TC\",-apple-system,sans-serif;font-size:14px;font-weight:500;transition:background .15s ease}.ds-btn-ghost:hover{background:var(--bg-tertiary,#1b302b)}.ds-btn-ghost:focus-visible{outline:2px solid var(--focus-ring,#c9a24b);outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "色調填色加髮絲線邊框。focus 時邊框轉為強調色並加 1px 環。",
      "html": "<input class=\"ds-input\" placeholder=\"http://192.168.1.100:8080\" />",
      "css": ".ds-input{width:100%;box-sizing:border-box;padding:8px 12px;border:1px solid var(--border-subtle,#274039);border-radius:var(--radius-md,8px);background:var(--bg-secondary,#132320);color:var(--text-primary,#eae4d6);font-family:\"Noto Sans TC\",-apple-system,sans-serif;font-size:14px;transition:border-color .15s ease,box-shadow .15s ease}.ds-input::placeholder{color:var(--text-muted,#8fa096)}.ds-input:focus{outline:none;border-color:var(--accent-primary,#c9a24b);box-shadow:0 0 0 1px var(--accent-primary,#c9a24b)}.ds-input:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "一張卡片之所以是卡片，是因為它比頁面亮一階——陰影只是確認它。",
      "html": "<div class=\"ds-card\"><div class=\"ds-card-title\">連線設定</div><div class=\"ds-card-desc\">設定 qBittorrent 連線資訊，以便從 Vido 監控下載狀態。</div></div>",
      "css": ".ds-card{border-radius:var(--radius-lg,12px);background:var(--bg-secondary,#132320);box-shadow:0 4px 8px rgba(0,0,0,.4);padding:24px;font-family:\"Noto Sans TC\",-apple-system,sans-serif}.ds-card-title{font-size:18px;font-weight:600;line-height:1;color:var(--text-primary,#eae4d6);margin-bottom:6px}.ds-card-desc{font-size:14px;line-height:1.6;color:var(--text-secondary,#a8b3ac)}"
    },
    {
      "name": "Running Badge",
      "kind": "chip",
      "refersTo": "badge-running",
      "description": "綠色代表「現在正在發生」。絕不用於已完成的事。",
      "html": "<span class=\"ds-badge-running\">生成中</span>",
      "css": ".ds-badge-running{display:inline-flex;align-items:center;padding:2px 8px;border-radius:var(--radius-sm,4px);background:rgba(111,191,168,.12);color:var(--success-text,#8fd3be);font-family:\"Noto Sans TC\",-apple-system,sans-serif;font-size:12px;font-weight:500;line-height:1.4}"
    },
    {
      "name": "Asked Badge",
      "kind": "chip",
      "refersTo": "badge-asked",
      "description": "系統裡最重要的一個標記：你要求了，而它沒有在發生。這是唯一能浮現「系統與使用者意願不一致」的方式。",
      "html": "<span class=\"ds-badge-asked\">伺服器未啟用</span>",
      "css": ".ds-badge-asked{display:inline-flex;align-items:center;padding:2px 8px;border-radius:var(--radius-sm,4px);background:rgba(212,118,63,.12);color:var(--warning-text,#e8b04b);font-family:\"Noto Sans TC\",-apple-system,sans-serif;font-size:12px;font-weight:500;line-height:1.4}"
    },
    {
      "name": "Fault Badge",
      "kind": "chip",
      "refersTo": "badge-fault",
      "description": "壞掉了。使用 AA-safe 的紅色文字階，而非飽和的填色色。",
      "html": "<span class=\"ds-badge-fault\">失敗</span>",
      "css": ".ds-badge-fault{display:inline-flex;align-items:center;padding:2px 8px;border-radius:var(--radius-sm,4px);background:rgba(192,57,43,.12);color:var(--error-text,#e08a76);font-family:\"Noto Sans TC\",-apple-system,sans-serif;font-size:12px;font-weight:500;line-height:1.4}"
    },
    {
      "name": "Sidebar Nav Item",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "active 狀態是 15% 強調色淡洗，絕不實心填滿。此處展示的是 active 狀態。",
      "html": "<a class=\"ds-nav-item ds-nav-item-active\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg><span>設定</span></a>",
      "css": ".ds-nav-item{display:flex;align-items:center;gap:12px;min-height:44px;padding:8px 10px;border-radius:var(--radius-md,8px);color:var(--text-muted,#8fa096);font-family:\"Noto Sans TC\",-apple-system,sans-serif;font-size:14px;font-weight:500;text-decoration:none;transition:background .15s ease,color .15s ease}.ds-nav-item:hover{background:var(--bg-tertiary,#1b302b);color:var(--text-primary,#eae4d6)}.ds-nav-item-active{background:rgba(201,162,75,.15);color:var(--text-primary,#eae4d6);font-weight:600}.ds-nav-item:focus-visible{outline:2px solid var(--focus-ring,#c9a24b);outline-offset:2px}"
    },
    {
      "name": "Status Row",
      "kind": "custom",
      "description": "活動中心背後的招牌模式。圖示晶片、標題、原因說明、右側槽。右槽在沒有真實進度時顯示「進行中」——而且完全不渲染進度條，不是渲染一條空的。",
      "html": "<div class=\"ds-status-row\"><div class=\"ds-status-chip\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z\"/></svg></div><div class=\"ds-status-text\"><div class=\"ds-status-title\">字幕生成中</div><div class=\"ds-status-detail\">龍族前傳 S03E01</div></div><span class=\"ds-status-right\">進行中</span></div>",
