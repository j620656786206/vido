  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "唯一以實心承載強調色的控制項。用於一個畫面上「確認送出」的那個動作。",
      "html": "<button class=\"ds-btn-primary\">儲存設定</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border:none;border-radius:var(--radius-md,8px);background:var(--accent-primary,#3b82f6);color:#fff;font-family:\"Noto Sans TC\",-apple-system,sans-serif;font-size:14px;font-weight:500;box-shadow:0 1px 2px rgba(0,0,0,.3);transition:background .15s ease}.ds-btn-primary:hover{background:var(--accent-hover,#60a5fa)}.ds-btn-primary:active{background:var(--accent-pressed,#2563eb)}.ds-btn-primary:focus-visible{outline:2px solid var(--focus-ring,#3b82f6);outline-offset:2px}.ds-btn-primary:disabled{opacity:.5;pointer-events:none}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "主要按鈕旁的非確認動作。色調式，不用強調色。",
      "html": "<button class=\"ds-btn-secondary\">測試連線</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border:none;border-radius:var(--radius-md,8px);background:var(--bg-tertiary,#2e3b56);color:var(--text-primary,#f2f2f2);font-family:\"Noto Sans TC\",-apple-system,sans-serif;font-size:14px;font-weight:500;box-shadow:0 1px 2px rgba(0,0,0,.3);transition:background .15s ease}.ds-btn-secondary:hover{background:rgba(46,59,86,.8)}.ds-btn-secondary:focus-visible{outline:2px solid var(--focus-ring,#3b82f6);outline-offset:2px}.ds-btn-secondary:disabled{opacity:.5;pointer-events:none}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "未 hover 前沒有填色。密集列中純圖示動作的預設選擇。",
      "html": "<button class=\"ds-btn-ghost\">取消</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:8px 16px;border:none;border-radius:var(--radius-md,8px);background:transparent;color:var(--text-primary,#f2f2f2);font-family:\"Noto Sans TC\",-apple-system,sans-serif;font-size:14px;font-weight:500;transition:background .15s ease}.ds-btn-ghost:hover{background:var(--bg-tertiary,#2e3b56)}.ds-btn-ghost:focus-visible{outline:2px solid var(--focus-ring,#3b82f6);outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "色調填色加髮絲線邊框。focus 時邊框轉為強調色並加 1px 環。",
      "html": "<input class=\"ds-input\" placeholder=\"http://192.168.1.100:8080\" />",
      "css": ".ds-input{width:100%;box-sizing:border-box;padding:8px 12px;border:1px solid var(--border-subtle,#374461);border-radius:var(--radius-md,8px);background:var(--bg-secondary,#24304a);color:var(--text-primary,#f2f2f2);font-family:\"Noto Sans TC\",-apple-system,sans-serif;font-size:14px;transition:border-color .15s ease,box-shadow .15s ease}.ds-input::placeholder{color:var(--text-muted,#a0aabe)}.ds-input:focus{outline:none;border-color:var(--accent-primary,#3b82f6);box-shadow:0 0 0 1px var(--accent-primary,#3b82f6)}.ds-input:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "一張卡片之所以是卡片，是因為它比頁面亮一階——陰影只是確認它。",
      "html": "<div class=\"ds-card\"><div class=\"ds-card-title\">連線設定</div><div class=\"ds-card-desc\">設定 qBittorrent 連線資訊，以便從 Vido 監控下載狀態。</div></div>",
      "css": ".ds-card{border-radius:var(--radius-lg,12px);background:var(--bg-secondary,#24304a);box-shadow:0 4px 8px rgba(0,0,0,.4);padding:24px;font-family:\"Noto Sans TC\",-apple-system,sans-serif}.ds-card-title{font-size:18px;font-weight:600;line-height:1;color:var(--text-primary,#f2f2f2);margin-bottom:6px}.ds-card-desc{font-size:14px;line-height:1.6;color:var(--text-secondary,#b3b3b3)}"
    },
    {
      "name": "Running Badge",
      "kind": "chip",
      "refersTo": "badge-running",
      "description": "綠色代表「現在正在發生」。絕不用於已完成的事。",
      "html": "<span class=\"ds-badge-running\">生成中</span>",
      "css": ".ds-badge-running{display:inline-flex;align-items:center;padding:2px 8px;border-radius:var(--radius-sm,4px);background:rgba(34,197,94,.12);color:var(--success,#22c55e);font-family:\"Noto Sans TC\",-apple-system,sans-serif;font-size:12px;font-weight:500;line-height:1.4}"
    },
    {
      "name": "Asked Badge",
      "kind": "chip",
      "refersTo": "badge-asked",
      "description": "系統裡最重要的一個標記：你要求了，而它沒有在發生。這是唯一能浮現「系統與使用者意願不一致」的方式。",
      "html": "<span class=\"ds-badge-asked\">伺服器未啟用</span>",
      "css": ".ds-badge-asked{display:inline-flex;align-items:center;padding:2px 8px;border-radius:var(--radius-sm,4px);background:rgba(245,158,11,.12);color:var(--warning,#f59e0b);font-family:\"Noto Sans TC\",-apple-system,sans-serif;font-size:12px;font-weight:500;line-height:1.4}"
    },
    {
      "name": "Fault Badge",
      "kind": "chip",
      "refersTo": "badge-fault",
