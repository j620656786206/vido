{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project web --web",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/web",
        "command": "vitest {args._.join(' ')}; EXIT_CODE=$?; cd ../.. && bash scripts/cleanup-test-processes.sh --all 2>/dev/null; exit $EXIT_CODE"
      },
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/apps/api/internal/services/testdata/resolution_tiers.json",
        { "externalDependencies": ["vitest"] },
        { "env": "CI" }
      ],
      "outputs": ["{workspaceRoot}/coverage/apps/web"]
    }
  }
}
