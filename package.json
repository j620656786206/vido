{
  "name": "@vido/source",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:all": "pnpm nx run-many -t lint && pnpm run lint && pnpm run format:check",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit-core --project=mobile-chrome --project=mobile-safari",
    "test:e2e:ui": "playwright test --ui --project=chromium --project=firefox --project=webkit-core --project=mobile-chrome --project=mobile-safari",
    "test:e2e:headed": "playwright test --headed --project=chromium --project=firefox --project=webkit-core --project=mobile-chrome --project=mobile-safari",
    "test:e2e:debug": "playwright test --debug --project=chromium --project=firefox --project=webkit-core --project=mobile-chrome --project=mobile-safari",
    "test:e2e:codegen": "playwright codegen",
    "test:e2e:report": "playwright show-report",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:visual:update-missing": "playwright test --project=visual --update-snapshots=missing",
    "test:bisect": "playwright test --project=bisect",
    "test:api": "playwright test --grep @api",
    "test:api:movies": "playwright test tests/e2e/movies.api.spec.ts",
    "test:api:series": "playwright test tests/e2e/series.api.spec.ts",
    "test:api:settings": "playwright test tests/e2e/settings.api.spec.ts",
    "test:api:health": "playwright test tests/e2e/health.api.spec.ts",
    "test:api:metadata": "playwright test tests/e2e/metadata-editor.api.spec.ts",
    "test:e2e:metadata": "playwright test tests/e2e/metadata-editor.spec.ts",
    "test:story:3-7": "playwright test --grep @story-3-7",
    "test:story:3-8": "playwright test --grep @story-3-8",
    "test:ci": "playwright test --grep @ci",
    "test:smoke": "playwright test --grep @smoke",
    "test:burn-in": "bash scripts/burn-in.sh",
    "test:burn-in:strict": "bash scripts/burn-in.sh 20",
    "test:changed": "bash scripts/test-changed.sh",
    "test:ci-local": "bash scripts/ci-local.sh",
    "test:cleanup": "bash scripts/cleanup-test-processes.sh --list",
    "test:cleanup:all": "bash scripts/cleanup-test-processes.sh --all",
    "prepare": "husky"
  },
