                  "type": "text",
                  "id": "SOwXf",
                  "name": "note",
                  "fill": "$text-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "因此沒有「記號平常不出現、異常才出現」的變體——那會讓同一個符號同時說「要花錢」和「不知道多少」，並且反向破壞免費訊號。",
                  "lineHeight": "$Type/Label/Line",
                  "fontFamily": "$Type/Family/Primary",
                  "fontSize": "$Type/Label/Size",
                  "fontWeight": "normal"
