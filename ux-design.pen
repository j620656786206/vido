                  "name": "ruling-line-3",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "唯一的閘門是 has_local_file：沒有本地檔案的集不出現任何動作（TMDb 有、NAS 沒有的集不可誤導使用者）。",
                  "lineHeight": "$Type/Body/Line",
                  "fontFamily": "$Type/Family/Primary",
                  "fontSize": "$Type/Body/Size",
                  "fontWeight": "$Type/Body/Weight"
                },
