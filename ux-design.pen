                  "name": "標題",
                  "fill": "$text-primary",
                  "content": "讀數帶「需要注意」格：金額顯示規則",
                  "lineHeight": "$Type/H3/Line",
                  "fontFamily": "$Type/Family/Primary",
                  "fontSize": "$Type/H3/Size",
