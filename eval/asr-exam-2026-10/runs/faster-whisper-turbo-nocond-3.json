compression_ratio": 1.6346153846153846, "no_speech_prob": 3.139101825699875e-11}, {"id": 22, "start": 418.92, "end": 419.32, "text": " Knowledge.", "avg_logprob": -0.26976750103326946, "compression_ratio": 1.6346153846153846, "no_speech_prob": 3.139101825699875e-11}, {"id": 23, "start": 421.02, "end": 422.36, "text": " Knowledge that will begin a new world.", "avg_logprob": -0.26976750103326946, "compression_ratio": 1.6346153846153846, "no_speech_prob": 3.139101825699875e-11}, {"id": 24, "start": 424.14, "end": 425.78, "text": " Better even than the world of our ancestors.", "avg_logprob": -0.26976750103326946, "compression_ratio": 1.6346153846153846, "no_speech_prob": 3.139101825699875e-11}, {"id": 25, "start": 426.18, "end": 436.69, "text": " We will be together.", "avg_logprob": -0.26976750103326946, "compression_ratio": 1.6346153846153846, "no_speech_prob": 3.139101825699875e-11}, {"id": 26, "start": 451.72, "end": 452.92, "text": " Name them Haniwa and Kofun.", "avg_logprob": -0.26976750103326946, "compression_ratio": 1.6346153846153846, "no_speech_prob": 3.139101825699875e-11}, {"id": 27, "start": 453.58, "end": 455.16, "text": " That way, I will know them when they come to me.", "avg_logprob": -0.29744921142893627, "compression_ratio": 1.724770642201835, "no_speech_prob": 2.8148256295268403e-11}, {"id": 28, "start": 458.02, "end": 459.12, "text": " And when will they come to you?", "avg_logprob": -0.29744921142893627, "compression_ratio": 1.724770642201835, "no_speech_prob": 2.8148256295268403e-11}, {"id": 29, "start": 459.22, "end": 460.26, "text": " The answers are all in the box.", "avg_logprob": -0.29744921142893627, "compression_ratio": 1.724770642201835, "no_speech_prob": 2.8148256295268403e-11}, {"id": 30, "start": 461.02, "end": 461.3, "text": " Wait.", "avg_logprob": -0.29744921142893627, "compression_ratio": 1.724770642201835, "no_speech_prob": 2.8148256295268403e-11}, {"id": 31, "start": 462.66, "end": 463.14, "text": " Jule Morrell.", "avg_logprob